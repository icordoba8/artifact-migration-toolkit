{
  "servers": {
    "start-migration": {
      "type": "stdio",
      "command": "node",
      "args": [
        "{{ENGINE_MCP_ENTRY}}",
        "--without-relay"
      ]
    }
  },
  "mcpServers": {
    "start-migration": {
      "type": "stdio",
      "command": "node",
      "args": [
        "{{ENGINE_MCP_ENTRY}}",
        "--without-relay"
      ],
      "tools": [
        "artifact_status",
        "artifact_run",
        "migration_status",
        "migration_scan",
        "migration_evidence_binding",
        "migration_prefill",
        "migration_capture",
        "migration_pending_decisions",
        "migration_run"
      ],
      "env": {
        "pnpm_config_pm_on_fail": "error"
      }
    }
  }
}
