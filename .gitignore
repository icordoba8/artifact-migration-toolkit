node_modules/

# Release staging. Generated by scripts/release.mjs from an already committed
# tree: build-identity.json, the rendered provider manifests, release-manifest.json
# and SHA256SUMS all carry the identity and therefore cannot be committed inputs
# to the hash that produces them.
dist/

# An identity file belongs to a built release, never to the source tree. The
# test runner installs a fixture one here for the suites that must run as an
# identified toolkit, and a committed one would both forge an identity for every
# checkout and dirty the tree a real release refuses to build from.
packages/*/build-identity.json
