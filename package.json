{
  "name": "artifact-migration-tools",
  "version": "1.3.15",
  "private": true,
  "type": "module",
  "description": "Standalone, versioned migration toolkit: canonical start-migration and migrate-artifact skills plus the one canonical migration engine.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
