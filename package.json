    "engine:test:ts": "node scripts/engine-test-ts.mjs",
    "providers:test": "node --test --test-concurrency=1 test/providers-sync.test.mjs test/provider-installation.test.mjs test/provider-progress-parity.test.mjs test/provider-runtime-matrix.test.mjs test/runtime-bootstrap.test.mjs test/release-version-discipline.test.mjs test/concurrent-suites.test.mjs test/installed-full-lifecycle.test.mjs test/portability-support.test.mjs",
    "providers:test:1": "node --test --test-concurrency=1 test/provider-runtime-matrix.test.mjs",
    "providers:test:2": "node --test --test-concurrency=1 test/provider-installation.test.mjs test/runtime-bootstrap.test.mjs",
    "providers:test:3": "node --test --test-concurrency=1 test/providers-sync.test.mjs test/provider-progress-parity.test.mjs test/release-version-discipline.test.mjs test/concurrent-suites.test.mjs test/installed-full-lifecycle.test.mjs test/portability-support.test.mjs",
    "test": "pnpm engine:test && pnpm engine:test:ts && pnpm providers:test",
    "providers:sync": "node scripts/providers-sync.mjs",
    "providers:check": "node scripts/providers-sync.mjs --check",
    "skills:lock": "node scripts/skills-lock.mjs",
    "release:check": "node scripts/release.mjs --check",
    "release:build": "node scripts/release.mjs --build",
    "release:verify": "node scripts/release.mjs --verify",
    "release:record": "node scripts/release.mjs --record"
  },
  "devDependencies": {
    "vitest": "^4.1.10",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "@artifact-migration-tools/migration-engine": "workspace:*"
  }
}
